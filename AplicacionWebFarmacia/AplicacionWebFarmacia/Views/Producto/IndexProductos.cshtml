@model IEnumerable<AplicacionWebFarmacia.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<h1>Tabla de los productos</h1>

<p>
    <a asp-controller="CRUD" asp-action="Create" class="btn btn-primary">Crear nuevo producto</a>
</p>

<table class="table table-productos">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre del producto</th>
            <th>Fecha de ingreso</th>
            <th>Cantidad stock</th>
            <th>Precio</th>
            <th>Descripcion</th>
            <th>Fecha de vencimiento</th>
            <th>Tipo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.idProducto)</td>
                <td>@Html.DisplayFor(modelItem => item.nombreProducto)</td>
                <td>@Html.DisplayFor(modelItem => item.fechaIngreso)</td>
                <td>@Html.DisplayFor(modelItem => item.cantidadProducto)</td>
                <td>@Html.DisplayFor(modelItem => item.precio)</td>
                <td>@Html.DisplayFor(modelItem => item.descripcion)</td>
                <td>@Html.DisplayFor(modelItem => item.fechaVencimiento)</td>
                <td>@Html.DisplayFor(modelItem => item.tipo)</td>
                <td>
                    @Html.ActionLink("Editar", "Edit", "CRUD", new { idProducto = item.idProducto }, new { @class = "btn btn-primary btn-sm" })
                    @Html.ActionLink("Eliminar", "Delete", "CRUD", new { idProducto = item.idProducto }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
