@{
    ViewData["Title"] = "Contacto";
}

<h1 class="text-center">Contáctanos</h1>

<div class="row justify-content-center">
    <div class="col-md-8">
        
        <div class="card shadow-sm p-4 mb-4">
            <h3 class="text-primary mb-3">Farmacia Vida Salud</h3>
            <p>
                Somos una farmacia familiar comprometida con la salud y el bienestar de nuestra comunidad en Santiago. 
                Contamos con una amplia variedad de medicamentos, productos de cuidado personal, suplementos y artículos de higiene.
            </p>
            
            <h5 class="mt-4">¿Qué puedes encontrar con nosotros?</h5>
            <ul>
                <li>Medicamentos éticos y genéricos</li>
                <li>Productos de dermocosmética y cuidado personal</li>
                <li>Suplementos vitamínicos</li>
                <li>Artículos de higiene y primeros auxilios</li>
                <li>Antialérgicos, antigripales y más</li>
            </ul>

            <hr class="my-4">

            <h5>Información de Contacto</h5>
            <p><strong>Dirección:</strong> Av. Providencia 1234, Santiago Centro</p>
            <p><strong>Teléfono:</strong> +56 9 8765 4321</p>
            <p><strong>Email:</strong> <a href="mailto:farmaciavidasalud.contacto@gmail.com">farmaciavidasalud.contacto@gmail.com</a></p>
            <p><strong>Horario:</strong> Lunes a Sábado: 8:30 - 20:00 hrs</p>

            <div class="mt-4 text-center">
                <p class="lead">¡Tu salud es nuestra prioridad!</p>
            </div>
        </div>


        <div class="card shadow-sm p-4">
            <h4 class="mb-3">Envíanos un mensaje</h4>
            <form>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" placeholder="Tu nombre" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" placeholder="tu@email.com" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Mensaje</label>
                    <textarea class="form-control" rows="5" placeholder="¿En qué podemos ayudarte?"></textarea>
                </div>
                <div class="text-center">
                    <button type="button" class="btn btn-primary btn-lg px-5">Enviar Mensaje</button>
                </div>
            </form>
            <p class="text-muted text-center mt-3 small">* Este es un formulario de demostración.</p>
        </div>

    </div>
</div>