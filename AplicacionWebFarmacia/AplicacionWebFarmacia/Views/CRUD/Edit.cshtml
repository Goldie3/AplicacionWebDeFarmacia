@model AplicacionWebFarmacia.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<h2>Editar Producto</h2>

<form asp-controller="CRUD" asp-action="Edit">
    <input type="hidden" asp-for="idProducto" />
    <div class="form-group">
        <label asp-for="nombreProducto"></label>
        <input asp-for="nombreProducto" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="fechaIngreso"></label>
        <input asp-for="fechaIngreso" class="form-control" type="date" />
    </div>
    <div class="form-group">
        <label asp-for="cantidadProducto"></label>
        <input asp-for="cantidadProducto" class="form-control" type="number" />
    </div>
    <div class="form-group">
        <label asp-for="precio"></label>
        <input asp-for="precio" class="form-control" type="number" step="0.01" />
    </div>
    <div class="form-group">
        <label asp-for="descripcion"></label>
        <textarea asp-for="descripcion" class="form-control"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="fechaVencimiento"></label>
        <input asp-for="fechaVencimiento" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-controller="Producto" asp-action="IndexProductos" class="btn btn-secondary">Cancelar</a>
</form>
